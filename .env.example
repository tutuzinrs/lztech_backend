# Porta do servidor backend
PORT=4000

# String de conexão do Neon PostgreSQL (gerada automaticamente na Vercel ou copiada do console Neon)
# Na Vercel, a integração com o Neon preenche automaticamente POSTGRES_URL ou DATABASE_URL.
POSTGRES_URL=postgresql://usuario:senha@ep-exemplo.region.aws.neon.tech/neondb?sslmode=require

# Chave secreta para assinatura dos tokens do admin
LZTECH_SECRET=coloque_uma_chave_segura_aqui
